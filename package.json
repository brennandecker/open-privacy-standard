{
  "name": "@open-privacy-standard/consent",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "OPS consent API, PostgreSQL ledger, and server-side TypeScript SDK",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/src/sdk.d.ts",
      "import": "./dist/src/sdk.js"
    }
  },
  "files": [
    "dist/src",
    "migrations",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/migrate.js",
    "example": "node dist/examples/receipt-and-marketing.js"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
